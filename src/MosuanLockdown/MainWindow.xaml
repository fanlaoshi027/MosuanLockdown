<Window x:Class="MosuanLockdown.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="墨算终端管家 · v0.23 安全预览版"
 Width="1080" Height="800" MinWidth="850" MinHeight="640"
 WindowStartupLocation="CenterScreen" Background="#F3F6FB" FontFamily="Microsoft YaHei UI">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="MinHeight" Value="38"/>
   <Setter Property="Padding" Value="16,7"/>
   <Setter Property="Margin" Value="0,5,10,5"/>
   <Setter Property="Background" Value="#EAF1FC"/>
   <Setter Property="BorderBrush" Value="#CAD8EC"/>
   <Setter Property="Foreground" Value="#193B67"/>
  </Style>
  <Style TargetType="TextBlock" x:Key="SectionHeading">
   <Setter Property="FontSize" Value="19"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#203650"/>
   <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="Padding" Value="18,13"/>
   <Setter Property="MinWidth" Value="160"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Border Background="White" Padding="26,18" BorderBrush="#DDE5F0" BorderThickness="0,0,0,1">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="墨算终端管家  v0.23" FontSize="27" FontWeight="Bold" Foreground="#18365B"/>
     <TextBlock Text="Windows 学生电脑管理 · 只读检查与配置预览" Margin="0,5,0,0" Foreground="#667A93"/>
    </StackPanel>
    <Border Grid.Column="1" Background="#E9F3FF" CornerRadius="10" Padding="16,10" VerticalAlignment="Center">
     <TextBlock Text="安全预览版 · 不修改系统策略" Foreground="#17558B" FontWeight="SemiBold"/>
    </Border>
   </Grid>
  </Border>
  <TabControl Grid.Row="1" TabStripPlacement="Left" Margin="16" Background="White" BorderBrush="#DEE7F2">
   <TabItem Header="首页与安全检查">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
     <StackPanel>
      <Border Background="#FFF6E7" CornerRadius="10" Padding="14" Margin="0,0,0,14">
       <StackPanel>
        <TextBlock Text="部署状态：禁止部署（安全预览版）" Foreground="#875815" FontWeight="Bold" FontSize="16"/>
        <TextBlock Text="下方仅统计上一次只读检查结果；不能据此启用系统限制。" Foreground="#875815" TextWrapping="Wrap" Margin="0,5,0,0"/>
       </StackPanel>
      </Border>
      <Border Background="#EAF1FB" CornerRadius="10" Padding="14" Margin="0,0,0,18">
       <StackPanel>
        <TextBlock Text="上一次安全检查摘要" Foreground="#274668" FontWeight="SemiBold"/>
        <TextBlock x:Name="CheckSummary" Text="尚未运行检查 · 无结果" FontSize="16" FontWeight="SemiBold" Foreground="#25486F" Margin="0,7,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="CheckSummaryTime" Text="请点击下方按钮执行只读检查。" Foreground="#65778D" Margin="0,5,0,0" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
      <Border Background="#FDECEC" CornerRadius="10" Padding="14" Margin="0,0,0,18">
       <StackPanel>
        <TextBlock x:Name="DeploymentGateStatus" Text="部署门禁：未检查，禁止部署" FontSize="16" FontWeight="Bold" Foreground="#962E2E"/>
        <TextBlock x:Name="DeploymentGateDetails" Text="当前版本未提供系统策略部署入口。" Foreground="#813C3C" TextWrapping="Wrap" Margin="0,7,0,0"/>
       </StackPanel>
      </Border>
      <TextBlock Text="设备与账户" Style="{StaticResource SectionHeading}"/>
      <Border Background="#F5F8FC" CornerRadius="10" Padding="16" Margin="0,0,0,16">
       <TextBlock x:Name="SystemInfo" Text="正在检测…" TextWrapping="Wrap" Foreground="#41546B"/>
      </Border>
      <TextBlock Text="选择学生标准账户" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <ComboBox x:Name="StudentAccounts" DisplayMemberPath="DisplayName" Height="38" MaxWidth="520" HorizontalAlignment="Left" MinWidth="330"/>
      <TextBlock Text="仅显示能够确认不是管理员的本地标准用户。" Foreground="#6D7D91" Margin="0,8,0,16"/>
      <Button Content="运行部署前安全检查" HorizontalAlignment="Left" Click="Diagnose_Click"/>
      <Button Content="查看系统限制能力（只读）" HorizontalAlignment="Left" Click="InspectWindowsCapabilities_Click"/>
      <Button Content="Windows 11 Enterprise / Shell Launcher 检测（只读）" HorizontalAlignment="Left" Click="InspectEnterpriseShell_Click"/>
      <Button Content="预览学生专用播放器模式（不启用）" HorizontalAlignment="Left" Click="PreviewStudentKiosk_Click"/>
      <Button Content="导出学生 Shell 配置草案" HorizontalAlignment="Left" Click="ExportStudentShellProposal_Click"/>
      <TextBlock Text="此检测读取系统版本、Application Identity 服务及 MDM 注册表路径，不启用任何策略。" TextWrapping="Wrap" Foreground="#65778D" Margin="0,6,0,12"/>
      <TextBlock Text="检查结果和操作提示会显示在窗口底部；检查不代表已具备部署条件。" TextWrapping="Wrap" Foreground="#986315" Margin="0,12,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="配置生成">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
     <StackPanel>
      <TextBlock Text="允许的播放器程序" Style="{StaticResource SectionHeading}"/>
      <DockPanel Margin="0,0,0,12">
       <Button Content="选择 EXE" DockPanel.Dock="Right" Click="ChooseExe_Click"/>
       <TextBox x:Name="ExePath" IsReadOnly="True" Padding="10" VerticalContentAlignment="Center" Text="尚未选择"/>
      </DockPanel>
      <TextBlock Text="仅 Windows 11 22H2+ 可生成当前候选 XML；尚未完成官方完整 XSD 或实机部署验证。" Foreground="#986315" TextWrapping="Wrap" Margin="0,0,0,18"/>
      <WrapPanel>
       <Button Content="导出 Assigned Access XML" Click="Export_Click"/>
       <Button Content="检查已有 XML 文件" Click="ValidateXml_Click"/>
      </WrapPanel>
      <Border Height="1" Background="#DEE7F2" Margin="0,20,0,20"/>
      <TextBlock Text="播放器学生模式 · JSON 配置草案" Style="{StaticResource SectionHeading}"/>
      <CheckBox x:Name="BlockContextMenu" Content="禁用播放器右键菜单" IsChecked="True" Margin="0,5"/>
      <CheckBox x:Name="BlockUnsafeKeys" Content="禁用打开文件、保存、打印等危险快捷键" IsChecked="True" Margin="0,5"/>
      <CheckBox x:Name="BlockArbitraryFiles" Content="禁止浏览未授权的本地文件路径" IsChecked="True" Margin="0,5"/>
      <CheckBox x:Name="AllowPlaybackKeys" Content="允许播放暂停、快进、倍速和全屏快捷键" IsChecked="True" Margin="0,5"/>
      <WrapPanel Margin="0,10,0,0">
       <Button Content="导出 JSON 草案" Click="ExportPlayerPolicy_Click"/>
       <Button Content="导入并检查 JSON" Click="ImportPlayerPolicy_Click"/>
      </WrapPanel>
      <TextBlock Text="播放器尚未接入此 JSON 协议；勾选与导出均不会让限制生效。" Foreground="#986315" TextWrapping="Wrap" Margin="0,10,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="策略备份">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
     <StackPanel>
      <TextBlock Text="AppLocker 本地策略备份" Style="{StaticResource SectionHeading}"/>
      <TextBlock Text="导出当前本地 AppLocker 策略 XML，保存后重新读取并显示 SHA-256 校验值。" TextWrapping="Wrap" Foreground="#41546B" Margin="0,0,0,14"/>
      <Button Content="导出现有 AppLocker 本地策略 XML" HorizontalAlignment="Left" Click="ExportAppLocker_Click"/>
      <Border Height="1" Background="#DEE7F2" Margin="0,18,0,18"/>
      <TextBlock Text="Shell Launcher 当前配置清单（只读）" Style="{StaticResource SectionHeading}"/>
      <TextBlock Text="只读导出账户 SID、当前 Shell 配置和 SHA-256。尚非完整恢复备份，不可用于锁机部署。" TextWrapping="Wrap" Foreground="#986315" Margin="0,0,0,10"/>
      <Button Content="导出 Shell Launcher 只读清单" HorizontalAlignment="Left" Click="ExportShellInventory_Click"/>
      <TextBox x:Name="ExpectedShellHash" Margin="0,8,0,5" MaxLength="64" Padding="10" ToolTip="可选：导出时单独记录的 SHA-256（64位）"/>
      <Button Content="验证 Shell Launcher 快照" HorizontalAlignment="Left" Click="VerifyShellInventory_Click"/>
      <Button Content="查看管理员恢复步骤（只读）" HorizontalAlignment="Left" Click="PreviewRecovery_Click"/>
      <Border Height="1" Background="#DEE7F2" Margin="0,18,0,18"/>
      <TextBlock Text="验证已有备份（只读）" Style="{StaticResource SectionHeading}"/>
      <TextBlock Text="可以粘贴导出时记录的 SHA-256，验证文件是否保持一致。留空时仅检查 XML 格式并计算当前哈希。" TextWrapping="Wrap" Foreground="#41546B"/>
      <TextBox x:Name="ExpectedBackupHash" Margin="0,10,0,8" Padding="10" MaxLength="64" ToolTip="可选：64 位十六进制 SHA-256" />
      <Button Content="选择 AppLocker XML 并验证" HorizontalAlignment="Left" Click="VerifyAppLockerBackup_Click"/>
      <TextBlock Text="验证通过仅说明文件结构和可选哈希匹配，不证明策略可恢复。" TextWrapping="Wrap" Foreground="#986315" Margin="0,7,0,0"/>
      <Border Background="#FFF7E8" CornerRadius="8" Padding="16" Margin="0,18,0,0">
       <TextBlock Text="注意：这不是完整系统备份，不包含 GPO、MDM、Assigned Access 或 BitLocker 恢复密钥，也不具备一键恢复能力。" TextWrapping="Wrap" Foreground="#815B21"/>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="恢复准备">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
     <StackPanel>
      <TextBlock Text="恢复前人工核对" Style="{StaticResource SectionHeading}"/>
      <CheckBox x:Name="RecoveryAdmin" Content="已在 Windows 登录界面验证备用管理员账户及密码" Margin="0,7"/>
      <CheckBox x:Name="RecoveryBackup" Content="已完成系统备份，并确认恢复介质可用" Margin="0,7"/>
      <CheckBox x:Name="RecoveryBitLocker" Content="已确认 BitLocker 状态，必要时保存恢复密钥" Margin="0,7"/>
      <CheckBox x:Name="RecoveryPolicies" Content="已记录现有设备管理策略和 Assigned Access 配置" Margin="0,7"/>
      <Button Content="检查恢复准备情况" HorizontalAlignment="Left" Margin="0,16,0,0" Click="CheckRecovery_Click"/>
      <TextBlock Text="勾选仅为人工声明，软件无法验证密码、备份有效性或恢复密钥。" Foreground="#986315" TextWrapping="Wrap" Margin="0,12,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="日志与报告">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
     <StackPanel>
      <TextBlock Text="安全检查报告" Style="{StaticResource SectionHeading}"/>
      <TextBlock Text="重新运行只读诊断并导出 TXT。报告可能包含账户名称、设备名称及程序路径，请勿公开上传。" Foreground="#41546B" TextWrapping="Wrap" Margin="0,0,0,14"/>
      <Button Content="导出安全检查报告 TXT" HorizontalAlignment="Left" Click="ExportReport_Click"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="White" BorderBrush="#DEE7F2" BorderThickness="0,1,0,0" Padding="18,12">
   <StackPanel>
    <TextBlock Text="当前操作结果" FontWeight="SemiBold" Foreground="#243A55" Margin="0,0,0,5"/>
    <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
     <TextBlock x:Name="Status" Text="请选择左侧功能开始检查。当前版本不会修改 Windows 策略。" TextWrapping="Wrap" Foreground="#475D76"/>
    </ScrollViewer>
   </StackPanel>
  </Border>
 </Grid>
</Window>